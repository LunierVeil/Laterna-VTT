# Optional example. Scripts do not load this file automatically.
# Export chosen values in your shell; never commit a real .env.
PORT=8000
LANTERNA_TRUST_PROXY=0
# Set to the current reachable HTTPS tunnel address, or leave empty for LAN.
PUBLIC_URL=
