{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "resolveJsonModule": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src"]
}
